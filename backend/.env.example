# Production target: Supabase (Postgres + S3-compatible Storage), both free
# with no credit card required. Local dev can still use the docker-compose
# Postgres+MinIO stack — these values work for either, only the URLs differ.
# See docs/DEPLOYMENT.md for how to provision a Supabase project.

# Local dev default. Production: Supabase transaction-pooler connection string,
# e.g. postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
DATABASE_URL=postgresql+asyncpg://birdmap:birdmap_secret@db:5432/birdmap
SECRET_KEY=change-me-to-a-random-secret

# Local dev default (MinIO). Production: Supabase Storage's S3-compatible
# endpoint, e.g. https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=http://minio:9000
# Production: S3_ACCESS_KEY is the Supabase project ref, S3_SECRET_KEY is the
# service_role API key (Supabase dashboard → Project Settings → API).
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=birdmap-photos
MODEL_BUCKET=birdmap-models

# External URL clients use to fetch photos/thumbnails.
# Development: same as S3_ENDPOINT (http://localhost:9000)
# Production: https://<project-ref>.supabase.co/storage/v1
PUBLIC_S3_URL=http://localhost:9000

# Comma-separated allowed CORS origins. Use * for local dev only.
CORS_ORIGINS=*

# Secret for the ML pipeline to call POST /model/register
MODEL_REGISTER_SECRET=change-me-to-a-random-secret

# Max photo upload size in bytes (default 10 MB)
MAX_PHOTO_BYTES=10485760

# Firebase service account JSON (inline, single line) — used by
# app/api/media.py to verify the live app's Firebase ID tokens before
# proxying photo/audio uploads to Supabase Storage. Get one from Firebase
# Console → Project Settings → Service Accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Cloud Vision API — for photo bird ID (proxy through backend)
# Enable at: https://console.cloud.google.com → APIs & Services → Vision API
# Free tier: 1000 units/month
GOOGLE_CLOUD_API_KEY=

# eBird API — for species taxonomy/info (Wikipedia is used automatically without a key)
# Free key at: https://ebird.org/api/keygen
EBIRD_API_KEY=
