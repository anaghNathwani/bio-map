rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile, only write their own
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Sightings: public read (for web map), auth required to write
    match /sightings/{sightingID} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['latitude', 'longitude', 'mediaType', 'userId'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      // Allow incrementing annotationCount and updating topSpecies (from annotation submit),
      // and allow the trusted server-side annotation pipeline to set AI suggestion fields.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['annotationCount', 'topSpecies']))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Annotations subcollection
      match /annotations/{annotationID} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['species', 'confidence', 'userId', 'username']);
        // Owners may edit their own annotation, but only the fields they're allowed to set
        // themselves — moderation/moderationScore are written only by the trusted
        // server-side moderation pipeline (which uses the Admin SDK and bypasses these rules),
        // so a client can never self-clear a "flagged" verdict.
        allow update: if request.auth != null
          && request.auth.uid == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['species', 'confidence', 'behavior', 'agePlumage', 'reviewOfAI']);
        allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      }
    }

    // Model versions: published only by the trusted server-side pipeline
    // (Admin SDK, bypasses these rules — see ml_pipeline/publish_model.py).
    // Publicly readable so ModelManager can check for updates and download
    // the model without requiring a signed-in user. The model file itself is
    // too large for one document (1 MiB cap), so it's split into base64
    // chunk documents under the `chunks` subcollection — same rules apply.
    match /model_versions/{versionID} {
      allow read: if true;
      allow write: if false;

      match /chunks/{chunkID} {
        allow read: if true;
        allow write: if false;
      }
    }

    // "Join the waitlist" signups from the marketing site (web/src/components/WaitlistButton.jsx).
    // Write-only from any visitor, no auth — nobody can read this back, including other
    // visitors, so it can't be scraped for emails. Only
    // ml_pipeline/notify_waitlist_signups.py (Admin SDK, bypasses these rules, same pattern as
    // model_versions above) ever reads it, on a schedule, to email new signups and mark them
    // notified.
    match /waitlist/{signupID} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.email is string
        // iCloud addresses only (TestFlight invites go to the Apple ID) — keep in sync with
        // web/src/lib/waitlist.js.
        && request.resource.data.email.lower().matches('^[^@\\s]+@(icloud|me|mac)\\.com$')
        && request.resource.data.email.size() < 200
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() < 200));
      allow update, delete: if false;
    }

    // In-app bug reports / feature requests (ios FeedbackView -> FirebaseService.submitFeedback).
    // Signed-in users can only add their own; nobody can read, edit or delete them from a client.
    // ml_pipeline/notify_waitlist_signups.py (Admin SDK) emails new ones; they're also readable in
    // the Firebase console under `feedback`.
    match /feedback/{feedbackID} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['type', 'message', 'userId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'message', 'userId', 'createdAt', 'username',
             'email', 'appVersion', 'build', 'device', 'osVersion', 'notified'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.type in ['bug', 'feature', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 4000;
      allow update, delete: if false;
    }
  }
}
