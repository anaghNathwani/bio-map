rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read any profile, only write their own
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Sightings: public read (for web map), auth required to write
    match /sightings/{sightingID} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['latitude', 'longitude', 'mediaType', 'userId'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number;
      // Allow incrementing annotationCount and updating topSpecies (from annotation submit)
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['annotationCount', 'topSpecies']))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;

      // Annotations subcollection
      match /annotations/{annotationID} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll(['species', 'confidence', 'userId', 'username']);
        allow update, delete: if request.auth != null
          && request.auth.uid == resource.data.userId;
      }
    }
  }
}
