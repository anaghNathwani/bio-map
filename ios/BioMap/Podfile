platform :ios, '17.0'
use_frameworks!

# TensorFlowLiteSwift only — Firebase/GoogleSignIn/ZIPFoundation stay on SPM
# (managed by project.yml/xcodegen). This is the one dependency Google
# publishes only via CocoaPods, not SPM — see ML/BirdClassifier.swift for why
# the photo classifier needs it instead of CoreML/Vision.
target 'BioMap' do
  pod 'TensorFlowLiteSwift', '~> 2.14.0'
end

# TensorFlowLiteC (a transitive dependency of TensorFlowLiteSwift) ships with
# an IPHONEOS_DEPLOYMENT_TARGET of 12.0 on its Pods.xcodeproj targets,
# regardless of the `platform :ios, '17.0'` line above — confirmed: newer
# Xcode (supporting iOS 27) rejects anything below 15.0 outright ("range of
# supported deployment target versions is 15.0 to 27.0.x"). Force every pod
# target to match this project's real deployment target instead.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
end
