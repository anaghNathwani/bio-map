// VESTIGIAL — no longer used. Firebase Storage requires a linked billing
// account (Blaze plan) for any usage regardless of volume, so sighting
// photo/audio bytes are compressed client-side and embedded as base64 data
// URIs directly in the Firestore sighting document instead — genuinely free,
// no card, no Storage, no backend. See FirebaseService.uploadImage/
// uploadAudio and docs/DEPLOYMENT.md. Kept here, unused, in case of rollback.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Sighting media: owner can write, any logged-in user can read
    match /sightings/{sightingID}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // 20 MB max
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*'));
    }
  }
}
