// VESTIGIAL — no longer used. Firebase Storage now requires a linked billing
// account (Blaze plan) for any usage regardless of volume, so photo/audio/
// model blobs moved to Supabase Storage (free, no card required), proxied
// through the backend (backend/app/api/media.py) for uploads and fetched
// directly via public Supabase URLs for reads. Kept here, unused, in case of
// rollback — see docs/DEPLOYMENT.md and docs/ML_PIPELINE.md.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Sighting media: owner can write, any logged-in user can read
    match /sightings/{sightingID}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // 20 MB max
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*'));
    }
  }
}
