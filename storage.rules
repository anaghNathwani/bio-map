// Sighting photo/audio blobs, uploaded directly by the app via the
// FirebaseStorage SDK (FirebaseService.uploadImage/uploadAudio) — billing
// (Blaze) enabled on this project specifically to support this. See
// docs/DEPLOYMENT.md for the Supabase-broker alternative this replaced,
// kept documented there in case billing needs to come back off.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Sighting media: owner can write, any logged-in user can read
    match /sightings/{sightingID}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024  // 20 MB max
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*'));
    }
  }
}
