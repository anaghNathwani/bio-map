# Environment
.env
.env.*
!.env.example
*.env.local

# Credentials
firebase-service-account*.json
*-service-account*.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
.venv-convert/
.venv-train/
venv/
env/

# ML artifacts
*.pt
*.pth
*.onnx
*.mlpackage
*.mlmodel
# Exception: the classifier bundled into the app install itself (see
# ModelManager.swift's bundledModelURL) — this one must be tracked.
!ios/BirdMap/BirdMap/ML/Bundled/**
ml_pipeline/data/
ml_pipeline/output*/
ml_pipeline/checkpoints/

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcworkspace/contents.xcworkspacedata
# Exception: BirdMap.xcworkspace is the real CocoaPods-generated workspace
# (references both BirdMap.xcodeproj and Pods.xcodeproj) — must be tracked,
# unlike the auto-generated .xcodeproj/project.xcworkspace the rule above
# is actually meant for.
!ios/BirdMap/BirdMap.xcworkspace/contents.xcworkspacedata
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.moved-to-trash/
*.hmap
*.ipa
*.xcarchive

# CocoaPods (TensorFlowLiteSwift only — everything else stays on SPM via
# xcodegen/project.yml). Podfile.lock IS tracked (pins exact versions);
# Pods/ itself isn't — `pod install` fetches it, same as SPM resolves its
# own packages from Package.resolved.
ios/BirdMap/Pods/
.build/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Docker
docker-compose.override.yml

# Logs
*.log
logs/

# Backups
*.sql.gz
/backups/

# IDE
.idea/
.vscode/
*.swp
*.swo
web/node_modules/

# Supabase CLI local state (regenerated by `supabase link`/`db push`)
supabase/.temp/

# ML pipeline runtime cache
ml_pipeline/aiy_birds_common_names_cache.json
